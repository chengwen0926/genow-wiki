{
  "name": "genow-wiki-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run sync-media && next build --webpack && npm run build-search && npm run verify-tutorials && npm run verify-export",
    "sync-media": "node scripts/sync-media.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify-export": "node scripts/verify-export.mjs",
    "build-search": "node scripts/build-search.mjs",
    "verify-tutorials": "node scripts/verify-tutorials.mjs",
    "start": "node scripts/preview.mjs --production"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pagefind": "1.5.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
